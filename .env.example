# Copy to .env and fill in what you have. EVERYTHING is optional – the app runs fully offline without any key.

# ── 1. Gemini (Google AI Studio → https://aistudio.google.com/apikey) ─────────────────────────
# Used for: structured profile extraction, messy job-description parsing, match explanations,
# grounded scenario quizzes, practical-task grading, voice transcription and the tool-calling Copilot.
GEMINI_API_KEY=AIzaSyBRo4IcO8de7I2R-s0QySL7rr7-cPbWiiE
GEMINI_MODEL=gemini-2.5-flash

# ── 2. Embeddings ────────────────────────────────────────────────────────────────────────────
# Default: sentence-transformers/all-MiniLM-L6-v2 (auto-downloaded). Set EMBEDDING_BACKEND=hash to force the offline embedder.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=auto

# ── 3. Optional extras ───────────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=          # replaces YouTube search links with real top videos on each roadmap day (YouTube Data API v3)
GITHUB_TOKEN=             # raises GitHub API rate limits for the practical repo check
TELEGRAM_BOT_TOKEN=       # mirror notifications to Telegram (create a bot with @BotFather)
TELEGRAM_CHAT_ID=
